{
  "name": "risk-based-ecommerce-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Risk-based Playwright + TypeScript tests for the Tricentis Demo Web Shop.",
  "author": "Manimaran Murugan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
